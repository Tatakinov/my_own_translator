Language {
    ('ja', 'en', 'zh', 'zh-hant', 'ko', 'de', 'ru')
}

OnNOP {
}

OnMouseDoubleClick {
    '\![raise,OnMenu]'
}

OnMenu {
    '\_q\0'
    --
    case reference[0] {
        when 'Target' {
            target = reference[1]
        }
        when 'From' {
            from = reference[1]
        }
        when 'To' {
            to = reference[1]
        }
        when 'AllowSelection' {
            allow_selection = TOINT(reference[1])
        }
    }
    if target {
        'Target: ' + target + ' / \q[Stop translate,OnMenu,Target,]\n'
    }
    else {
        '\n'
    }
    --
    '\q[Select target,OnSelectTarget]\n'
    --
    '\n'
    --
    'From: ' + from + ' / \q[Select From,OnSelectFrom]\n'
    --
    '\n'
    --
    'To:   ' + to + ' / \q[Select To,OnSelectTo]\n'
    --
    '\n'
    --
    if allow_selection {
        '\![*] \q[Disallow selection from choices and anchors,OnMenu,AllowSelection,0]\n'
    }
    else {
        '\![*] \q[Allow selection from choices and anchors,OnMenu,AllowSelection,1]\n'
    }
    --
    '\n'
    --
    _str = ''
    foreach Validate; _x {
        _str += "Caution: model %(_x) not found. Please download it.\n"
        _str += "\![*]\q[How to download,OnHowToDownload,%(_x)]\n"
        _str += '\![*]\q[Detailed description,OnJump]\n'
        _str += '\n'
    }
    _str
    --
    '\n'
    --
    '\q[Close,OnNOP]\n'
    --
    '\_q'
}

OnGetProperty {
    _n = REPLACE(reference[0], '"', '""')
    "\![get,property,OnGetTargetGhostName,""ghostlist(%(_n)).name"",""ghostlist(%(_n)).sakuraname""]"
}

OnGetTargetGhostName {
    target_ghost_name = reference[0]
    _n = REPLACE(reference[1], '"', '""')
    "\![raise,OnMenu,Target,""%(_n)""]"
}

OnSelectTarget {
    _s = '\_q\0'
    foreach ghost_list; _g {
        _g = REPLACE(_g, '"', '""')
        _s += "\q[""%(_g)"",OnGetProperty,""%(_g)""]\n"
    }
    _s
    --
    '\n'
    --
    '\q[Back,OnNOP]\n\_q'
}

OnSelectFrom {
    _s = '\_q\0'
    foreach Language; _l {
        _s += "\q[%(_l),OnMenu,From,%(_l)] "
    }
    _s
    --
    '\n'
    --
    '\q[Back,OnMenu]\n\_q'
}

OnSelectTo {
    _s = '\_q\0'
    foreach Language; _l {
        _s += "\q[%(_l),OnMenu,To,%(_l)] "
    }
    _s
    --
    '\n'
    --
    '\q[Back,OnMenu]\n\_q'
}

OnHowToDownload {
    _lang = reference[0]
    '\_q\0'
    --
    if lang == 'Japanese' || lang == 'japanese' || lang == 'ja' {
        '1. https://mozilla.github.io/translations/ へアクセス\n'
        --
        '2. Model Registry をクリック\n'
        --
        "3. Filterに%(_lang)と入力\n"
        --
        '4. Show をクリックしてExportedの数字をクリック\n'
        --
        '5. model.*.bin(.gz) をダウンロード\n'
        --
        '6. lex.*.bin(.gz) をダウンロード\n'
        --
        '7-1. vocab.*.spm(.gz) をダウンロード\n'
        --
        '7-2. もしくは、srcvocab.*.spm(.gz) と trgvocab.*.spm(.gz) をダウンロード\n'
        --
        '8. ダウンロードした *.gz を展開\n'
        --
        "9. model.*.bin を /path/to/my_own_translator/ghost/master/model/%(_lang)/model.bin へコピー\n"
        --
        "10. lex.*.bin を /path/to/my_own_translator/ghost/master/model/%(_lang)/lex.bin へコピー\n"
        --
        "11-1. vocab.*.spm を /path/to/my_own_translator/ghost/master/model/%(_lang)/src.spm へ、さらにvocab.*.spm を /path/to/my_own_translator/ghost/master/model/%(_lang)/trg.spm へコピー\n"
        --
        "11-2. もしくは、srcvocab.*.spm を /path/to/my_own_translator/ghost/master/model/%(_lang)/src.spm へ、trgvocab.*.spm を /path/to/my_own_translator/ghost/master/model/%(_lang)/trg.spm へコピー\n"
        --
        "12. /path/to/my_own_translator/ghost/master/config.yml を /path/to/my_own_translator/model/%(_lang)/config.yml へコピー\n"
        --
        '\nクリックで閉じる\x'
    }
    else {
        '1. Access https://mozilla.github.io/translations/\n'
        --
        '2. Click Model Registry\n'
        --
        "3. input %(_lang) to Filter\n"
        --
        '4. Click Show and number located Exported\n'
        --
        '5. Download model.*.bin(.gz)\n'
        --
        '6. Download lex.*.bin(.gz)\n'
        --
        '7-1. Download vocab.*.spm(.gz)\n'
        --
        '7-2. otherwise, Download srcvocab.*.spm(.gz) and trgvocab.*.spm(.gz)\n'
        --
        '8. Expand *.gz you downloaded\n'
        --
        "9. Copy model.*.bin to /path/to/my_own_translator/ghost/master/model/%(_lang)/model.bin\n"
        --
        "10. Copy lex.*.bin to /path/to/my_own_translator/ghost/master/model/%(_lang)/lex.bin\n"
        --
        "11-1. Copy vocab.*.spm to /path/to/my_own_translator/ghost/master/model/%(_lang)/src.spm and Copy vocab.*.spm to /path/to/my_own_translator/ghost/master/model/%(_lang)/trg.spm\n"
        --
        "11-2. otherwise, Copy srcvocab.*.spm to /path/to/my_own_translator/ghost/master/model/%(_lang)/src.spm and Copy trgvocab.*.spm to /path/to/my_own_translator/ghost/master/model/%(_lang)/trg.spm\n"
        --
        "12. Copy /path/to/my_own_translator/ghost/master/config.yml to /path/to/my_own_translator/model/%(_lang)/config.yml\n"
        --
        '\nClick to close\x'
    }
}

OnJump {
    '\j[https://tatakinov.github.io/my_own_translator/index.html]'
}
