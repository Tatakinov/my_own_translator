OnInitialize {
    if !ISVAR('from') || ASEARCH(from, Language) == -1 {
        from = "ja"
    }
    if !ISVAR('to') || ASEARCH(to, Language) == -1 {
        to = "en"
    }
    target = ""
}

OnBoot {
    "\0\s[0]\![set,otherghosttalk,true]"
}

OnDestroy {
    ERASEVAR('ghost_list')
    ERASEVAR('target')
    ERASEVAR('correspondence')
    ERASEVAR('strict_correspondence')
    ERASEVAR('translation_list')
    ERASEVAR('lang')
}

OnLanguageChange {
    lang = reference[0]
}
